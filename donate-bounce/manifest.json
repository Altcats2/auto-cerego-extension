{
  "manifest_version": 3,
  "name": "Donate Bounce",
  "version": "1.0.0",
  "description": "After a while, a donate window shows up and bounces around your screen like the DVD logo.",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Donate Bounce",
    "default_popup": "popup.html"
  }
}
